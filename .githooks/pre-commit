#!/usr/bin/env bash
# Run scripts/check.js on the tree being committed: a copy of the index, so
# unstaged edits neither fail a commit nor leak into it. Generated files the
# checks rewrite are staged from that copy, and mirrored into the working tree
# where it has no unstaged edits of its own.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
# `commit -a` and `commit <paths>` stage into a temporary index; follow it.
if [[ -n "${GIT_INDEX_FILE:-}" && "$GIT_INDEX_FILE" != /* ]]; then
	export GIT_INDEX_FILE="$repo_root/$GIT_INDEX_FILE"
fi

snapshot="$(mktemp -d)"
# bash 3.2 (macOS) enters this trap with $? 0 after an unbound-variable exit,
# so only an exit that set `passed` counts as success.
passed=
trap 'status=$?; rm -rf "$snapshot"; [[ -n $passed ]] || exit $(( status ? status : 1 ))' EXIT
git checkout-index --all --prefix="$snapshot/"
ln -s "$repo_root/node_modules" "$snapshot/node_modules"
if [[ -d reports ]]; then
	ln -s "$repo_root/reports" "$snapshot/reports"
fi

if ! (cd "$snapshot" && node scripts/check.js); then
	echo "pre-commit: checks failed on the staged tree (unstaged edits aren't checked)." >&2
	exit 1
fi

in_snapshot() { git --work-tree="$snapshot" "$@"; }
generated=(README.md docs/status.md docs/coverage.html starter parity)

stray=()
while IFS= read -r f; do
	case "$f" in
		README.md | docs/status.md | docs/coverage.html | starter/* | parity/*) ;;
		*) stray+=("$f") ;;
	esac
done < <(in_snapshot diff --name-only)
if (( ${#stray[@]} > 0 )); then
	echo "pre-commit: scripts/check.js modified files it doesn't generate:" >&2
	printf '  %s\n' "${stray[@]}" >&2
	exit 1
fi

changed=()
while IFS= read -r f; do
	changed+=("$f")
done < <({ in_snapshot diff --name-only -- "${generated[@]}"; in_snapshot ls-files --others -- "${generated[@]}"; })
(( ${#changed[@]} > 0 )) || { passed=1; exit 0; }

# Where the working copy matches the index, it takes the regenerated file too.
mirror=()
for f in "${changed[@]}"; do
	if [[ ! -e "$f" ]] || git diff --quiet -- "$f"; then
		mirror+=("$f")
	fi
done
in_snapshot add -- "${changed[@]}"
# bash 3.2 treats an empty "${array[@]}" as unbound under set -u.
for f in ${mirror[@]+"${mirror[@]}"}; do
	mkdir -p "$(dirname "$f")"
	cp "$snapshot/$f" "$f"
done
echo "pre-commit: staged regenerated ${changed[*]}"
passed=1
