{
  "name": "screeps-ok",
  "version": "0.2.1",
  "description": "Behavioral conformance suite for Screeps server implementations",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parity/*": "./parity/*"
  },
  "files": [
    "src",
    "dist",
    "tests",
    "bin",
    "scripts/run-suite.js",
    "scripts/preflight.js",
    "scripts/lib",
    "starter",
    "parity",
    "behaviors.md",
    "CHANGELOG.md",
    "docs/adapter-spec.md",
    "docs/adapter-guide.md",
    "docs/test-authoring.md",
    "docs/behavior-matrices.md",
    "vitest.config.ts"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "prepack": "node scripts/generate-starter.js && npm run build && node scripts/validate-package.js",
    "build:starter": "node scripts/generate-starter.js",
    "preflight": "node scripts/preflight.js",
    "setup": "npm run setup:xxscreeps && npm run setup:vanilla",
    "setup:xxscreeps": "node scripts/build-xxscreeps.js && node scripts/setup.js xxscreeps",
    "setup:vanilla": "node scripts/setup.js vanilla",
    "pf:build": "node scripts/build-pathfinder.js",
    "pf:build:linux-x64": "docker run --rm --platform linux/amd64 -v \"$PWD\":/work -w /work debian:sid sh -c 'apt-get update && apt-get install -y --no-install-recommends ca-certificates clang-22 cmake git libboost-all-dev lld-22 llvm-22 ninja-build nodejs npm && node scripts/build-pathfinder.js'",
    "test": "node scripts/test.js",
    "posttest": "node scripts/generate-status.js && node scripts/generate-coverage.js",
    "test:watch": "vitest",
    "parity": "node scripts/parity-report.js",
    "coverage": "node scripts/generate-coverage.js",
    "status": "node scripts/generate-status.js",
    "status:refresh": "node scripts/generate-status.js && node scripts/generate-coverage.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "check": "node scripts/check.js",
    "validate:capabilities": "node scripts/validate-capabilities.js",
    "validate:docs": "node scripts/validate-docs.js",
    "validate:package": "node scripts/validate-package.js"
  },
  "bin": {
    "screeps-ok": "./bin/run.js"
  },
  "dependencies": {
    "@screeps/common": "^2.16.0"
  },
  "peerDependencies": {
    "vitest": "^3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "screeps": "^4.3.0",
    "screeps-server-mockup": "^1.5.1",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "private": false,
  "license": "MIT"
}
