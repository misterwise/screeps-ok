{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "screeps-ok": ["./src/index.ts"],
      "xxscreeps/*": [
        "./node_modules/xxscreeps/dist/types/*",
        "./node_modules/xxscreeps/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "adapters/**/*",
    "tests/**/*",
    "starter/**/*",
    "node_modules/xxscreeps/**/xx.d.ts"
  ],
  "exclude": ["dist"]
}
